# Postgres / Redis (docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://gatorway:gatorway@localhost:5432/gatorway
TEST_DATABASE_URL=postgresql+psycopg://gatorway:gatorway@localhost:5432/gatorway_test
REDIS_URL=redis://localhost:6379/0

# Gemini (AI Studio key) used by the API for intent parsing, edits and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
# gemini = real semantic search; hashing = offline stand-in (set the same value when ingesting and when running the MCP server)
EMBED_PROVIDER=gemini

# Auth: use a long random string (32+ bytes)
JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_TTL_MINUTES=1440

# Cloud Run extractor (locally: http://127.0.0.1:8080)
EXTRACTOR_URL=http://127.0.0.1:8080
EXTRACTOR_API_KEY=

# MCP server the API talks to
MCP_URL=http://127.0.0.1:8001/mcp
GEMINI_TOOLS=get_baseline,get_requirements,search_courses,validate_edits

# Ingestion input (scraper output)
SCRAPE_DIR=scraping/sfsu_output
