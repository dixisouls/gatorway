# Postgres / Redis (docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://gatorway:gatorway@localhost:5432/gatorway
TEST_DATABASE_URL=postgresql+psycopg://gatorway:gatorway@localhost:5432/gatorway_test
REDIS_URL=redis://localhost:6379/0

# Gemini for intent parsing, edits and embeddings. Preferred: Vertex AI through gcloud Application Default Credentials
# (run `gcloud auth application-default login` once; no key needed). Alternative: an AI Studio key in GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
# "global" serves the newest models; regional locations (us-central1) may 404 on them
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
# local = sentence-transformers on this machine (default); gemini; hashing = offline stand-in.
# Use the same value when ingesting and when running the MCP server.
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Sign-in: Firebase Authentication (Google). In the Firebase console: Build -> Authentication -> Sign-in method -> enable Email/Password,
# then Project settings -> Your apps -> add a Web app and copy its config. These are not secrets (the web key ships to every browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# The backend only needs the project id to check ID tokens (no secret, no service account)
FIREBASE_PROJECT_ID=
# true = require a verified email (off by default: any @sfsu.edu-style address can sign up)
REQUIRE_EMAIL_VERIFIED=false

# Cloud Run extractor (locally: http://127.0.0.1:8080)
EXTRACTOR_URL=http://127.0.0.1:8080
EXTRACTOR_API_KEY=

# MCP server the API talks to
MCP_URL=http://127.0.0.1:8001/mcp
GEMINI_TOOLS=get_baseline,get_requirements,search_courses,validate_edits

# Ingestion input (scraper output)
SCRAPE_DIR=scraping/sfsu_output

# Max seconds for Gemini to personalise a roadmap before the standard one is shown
EDIT_TIMEOUT_S=120

# Gemini reasoning effort: off (fastest) | LOW | MEDIUM | HIGH, or blank for the model default
GEMINI_THINKING_LEVEL=off

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Transcript redaction before text goes to Gemini: gliner (local nvidia/gliner-PII model) or stub (no redaction; tests and demos only)
REDACTOR=gliner
GLINER_MODEL=nvidia/gliner-PII
